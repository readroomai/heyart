# Public origin of the deployed app. Used for share links and Open Graph tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — the only authentication provider. https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Postgres + private image storage. https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# Google GenAI — vision analysis. https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
